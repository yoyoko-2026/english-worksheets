<section>
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">发音小口诀</span>
      <h2>记住这四句</h2>
      <p class="sub">口诀一背，发音不累。</p>
    </div>
    <div class="rules">
      <div class="rule reveal">
        <h4>一、有两点长长读</h4>
        <p><span class="sym">/iː/ /ɑː/ /ɔː/ /uː/ /ɜː/</span> 音标里有两个小点点，声音就要拉长一点。</p>
      </div>
      <div class="rule reveal">
        <h4>二、摸喉咙分清浊</h4>
        <p>手摸喉咙，抖的是浊辅音：<span class="sym">/b/ /d/ /g/ /v/ /z/ /ʒ/</span> …… 不抖的是清辅音。</p>
      </div>
      <div class="rule reveal">
        <h4>三、双元音滑过去</h4>
        <p>两个音标连在一起，前面长又重，后面短又轻，像坐滑梯一样滑过去。</p>
      </div>
      <div class="rule reveal">
        <h4>四、咬舌音轻轻咬</h4>
        <p><span class="sym">/θ/ /ð/</span> 两个音，舌尖轻轻放在上下牙齿中间，不要咬太重哦。</p>
      </div>
    </div>
  </div>
</section>

<!-- 结尾 -->
<section class="final">
  <div class="wrap">
    <div class="reveal">
      <div class="medal">🏆</div>
      <h2>恭喜通关！</h2>
      <p class="sub">48 个音标你都认识啦 🎉</p>
      <div class="task">
        <strong>课后小任务：</strong><br>
        每天早上大声读 <b>5 分钟</b>；<br>
        看到生词先猜音标，再查字典。
      </div>
    </div>
  </div>
</section>

<script>
/* ================= 有道真人发音引擎 ================= */
/* 有道词典发音接口：
   英音 type=1，美音 type=2
   例：https://dict.youdao.com/dictvoice?audio=see&type=2
*/
const YOUDAO_BASE = 'https://dict.youdao.com/dictvoice';
let audioPlayer = null;
let toastTimer = null;

function showToast(msg){
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), 1600);
}

function getAudioPlayer(){
  if(!audioPlayer){
    audioPlayer = new Audio();
    audioPlayer.preload = 'auto';
  }
  return audioPlayer;
}

/* 用有道播放单词 */
function playYoudao(word, accent){
  return new Promise((resolve, reject) => {
    if(!word){ reject(new Error('空单词')); return; }
    const type = accent === 'uk' ? 1 : 2;   // 默认美音
    const url = `${YOUDAO_BASE}?audio=${encodeURIComponent(word)}&type=${type}`;
    const player = getAudioPlayer();

    player.pause();
    player.currentTime = 0;
    player.src = url;

    const cleanup = () => {
      player.removeEventListener('canplay', onCanPlay);
      player.removeEventListener('error', onError);
    };
    const onCanPlay = () => { cleanup(); };
    const onError = () => { cleanup(); reject(new Error('音频加载失败')); };

    player.addEventListener('canplay', onCanPlay, { once:true });
    player.addEventListener('error', onError, { once:true });

    const p = player.play();
    if(p !== undefined){
      p.then(() => { cleanup(); resolve(); })
       .catch((err) => { cleanup(); reject(err); });
    }else{
      cleanup();
      resolve();
    }
  });
}

/* 系统 TTS 兜底（有道不可用时） */
const synth = window.speechSynthesis;
let enVoice = null;
function pickVoice(){
  if(!synth) return;
  const vs = synth.getVoices();
  enVoice = vs.find(v => /en-US/i.test(v.lang))
         || vs.find(v => /^en/i.test(v.lang))
         || null;
}
pickVoice();
if(synth) synth.onvoiceschanged = pickVoice;

function speakFallback(text){
  if(!synth || !text) return;
  synth.cancel();
  const u = new SpeechSynthesisUtterance(text);
  u.lang = 'en-US';
  u.rate = 0.82;
  if(enVoice) u.voice = enVoice;
  synth.speak(u);
}

/* 统一发音入口 */
async function pronounce(word, fallbackText){
  try{
    await playYoudao(word);
  }catch(err){
    console.warn('有道发音不可用，回退系统 TTS', err);
    speakFallback(fallbackText || word);
    showToast('真人发音加载失败，已切换为系统语音');
  }
}

/* 音标 → 标准例词映射表（点击音标时播放该例词，听到的就是该音标的标准发音） */
const IPA_WORD = {
  'iː': 'see',   'ɪ': 'sit',   'e': 'egg',    'æ': 'cat',
  'ɑː': 'car',   'ɒ': 'dog',   'ɔː': 'door',   'uː': 'food',
  'ʊ': 'book',   'ʌ': 'cup',   'ɜː': 'bird',   'ə': 'about',
  'eɪ': 'cake',  'aɪ': 'bike',  'ɔɪ': 'boy',   'əʊ': 'go',
  'aʊ': 'cow',   'ɪə': 'ear',   'eə': 'hair',   'ʊə': 'tour',
  'p': 'pen',  'b': 'book', 't': 'ten',  'd': 'dog',
  'k': 'cat',  'g': 'go',   'f': 'fish', 'v': 'very',
  's': 'sun',  'z': 'zoo',
  'θ': 'think', 'ð': 'this',
  'ʃ': 'she',  'ʒ': 'vision',
  'tʃ': 'chair', 'dʒ': 'jump',
  'tr': 'tree', 'dr': 'dream',
  'ts': 'cats', 'dz': 'beds',
  'm': 'mum',  'n': 'no',   'ŋ': 'sing',
  'l': 'leg',  'r': 'red',
  'j': 'yes',  'w': 'we',   'h': 'hat'
};

function getIpaKey(el){
  const raw = el.dataset.ipa || '';
  return raw.replace(/\//g,'').replace(/\s+/g,'').trim();
}

function flash(el){
  el.classList.remove('pop');
  void el.offsetWidth;
  el.classList.add('pop');
}

/* ================= 全局点击发音 ================= */
document.addEventListener('click', function(e){
  /* 点击音标 */
  const ipaEl = e.target.closest('[data-ipa]');
  if(ipaEl){
    e.stopPropagation();
    const key = getIpaKey(ipaEl);
    const word = IPA_WORD[key];
    if(word){
      pronounce(word, word);
    }else{
      /* 极端兜底：没有映射就用音标本身作为提示 */
      showToast('暂无该音标的例词');
    }
    flash(ipaEl);
    return;
  }

  /* 点击单词 */
  const wordEl = e.target.closest('[data-word]');
  if(wordEl){
    e.stopPropagation();
    const w = wordEl.dataset.word;
    pronounce(w, w);
    flash(wordEl);
    return;
  }
});

/* ================= 测验逻辑 ================= */
document.querySelectorAll('.quiz-q').forEach(function(q){
  q.querySelectorAll('.opt').forEach(function(btn){
    btn.addEventListener('click', function(){
      if(q.classList.contains('answered')) return;
      q.classList.add('answered');

      const isRight = btn.dataset.correct === '1';
      if(isRight){
        btn.classList.add('right');
      }else{
        btn.classList.add('wrong');
        const right = q.querySelector('.opt[data-correct="1"]');
        if(right) right.classList.add('right');
      }

      const fb = q.querySelector('.fb');
      fb.textContent = isRight ? '✅ 太棒了，就是这个音！' : '❌ 再想想，正确答案已经标出来啦～';
      fb.className = 'fb ' + (isRight ? 'ok' : 'no');
    });
  });
});

/* ================= 滚动进度条 ================= */
const bar = document.getElementById('progress');
window.addEventListener('scroll', function(){
  const h = document.documentElement.scrollHeight - window.innerHeight;
  const p = h > 0 ? (window.scrollY / h) * 100 : 0;
  bar.style.width = p + '%';
}, {passive:true});

/* ================= 入场动画 ================= */
const io = new IntersectionObserver(function(entries){
  entries.forEach(function(en){
    if(en.isIntersecting){
      en.target.classList.add('show');
      io.unobserve(en.target);
    }
  });
}, {threshold: 0.12});

document.querySelectorAll('.reveal').forEach(function(el, i){
  el.style.transitionDelay = (i % 6) * 55 + 'ms';
  io.observe(el);
});
</script>
</body>
</html>
