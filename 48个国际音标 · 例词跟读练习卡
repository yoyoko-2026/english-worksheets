<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>48个国际音标 · 例词跟读练习卡</title>
<style>
  :root{
    --cream:#FFF7EE;
    --orange:#E8833A;
    --orange-soft:#FDEBDC;
    --blue:#4A6FA5;
    --blue-soft:#E4EEF9;
    --yellow:#F5CE5E;
    --yellow-soft:#FDF6DF;
    --green:#4CAF7D;
    --red:#E05C5C;
    --ink:#3A3A4A;
    --muted:#8A8A9A;
    --line:#EDE2D6;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:"PingFang SC","Hiragino Sans GB","Microsoft YaHei",-apple-system,system-ui,sans-serif;
    background:var(--cream);
    color:var(--ink);
    line-height:1.7;
    -webkit-font-smoothing:antialiased;
    background-image:
      radial-gradient(circle at 12% 8%, rgba(245,206,94,.18), transparent 42%),
      radial-gradient(circle at 88% 22%, rgba(74,111,165,.12), transparent 40%),
      radial-gradient(circle at 50% 95%, rgba(232,131,58,.12), transparent 45%);
    background-attachment:fixed;
  }

  /* 顶部进度条 */
  #progress{
    position:fixed;top:0;left:0;height:4px;width:0%;
    background:linear-gradient(90deg,var(--yellow),var(--orange),var(--blue));
    z-index:99;transition:width .12s linear;border-radius:0 4px 4px 0;
  }

  .wrap{max-width:1080px;margin:0 auto;padding:0 clamp(16px,4vw,32px);}
  section{padding:clamp(48px,8vw,88px) 0;}

  .eyebrow{
    display:inline-block;font-size:13px;letter-spacing:2px;
    color:var(--orange);font-weight:700;background:var(--orange-soft);
    padding:5px 14px;border-radius:999px;margin-bottom:14px;
  }
  h2{
    font-size:clamp(22px,3.4vw,32px);font-weight:800;letter-spacing:.5px;
    margin-bottom:8px;
  }
  .sub{color:var(--muted);font-size:clamp(13px,1.8vw,15px);margin-bottom:26px;}

  /* 首屏 */
  .hero{
    min-height:100svh;display:flex;flex-direction:column;
    align-items:center;justify-content:center;text-align:center;
    padding:80px 20px;
  }
  .hero h1{
    font-size:clamp(38px,9vw,76px);font-weight:900;letter-spacing:2px;
    line-height:1.15;
    background:linear-gradient(120deg,var(--orange) 10%,#D9622B 45%,var(--blue) 95%);
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .hero .big{
    font-size:clamp(20px,3.6vw,30px);font-weight:800;color:var(--blue);
    margin-top:6px;letter-spacing:6px;
  }
  .hero .tags{
    display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin:28px 0 34px;
  }
  .tag{
    background:#fff;border:1.5px solid var(--line);border-radius:999px;
    padding:7px 18px;font-size:14px;font-weight:600;color:var(--muted);
    box-shadow:0 3px 10px rgba(180,150,120,.08);
  }
  .btn-main{
    display:inline-block;border:none;cursor:pointer;
    background:linear-gradient(135deg,var(--orange),#D9622B);
    color:#fff;font-size:17px;font-weight:800;letter-spacing:2px;
    padding:16px 44px;border-radius:999px;
    box-shadow:0 10px 26px rgba(217,98,43,.32);
    transition:transform .2s, box-shadow .2s;
    font-family:inherit;
  }
  .btn-main:hover{transform:translateY(-3px);box-shadow:0 16px 32px rgba(217,98,43,.4);}
  .btn-main:active{transform:translateY(0);}

  .bounce{animation:bounce 2.4s ease-in-out infinite;}
  @keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}

  /* 两关卡片 */
  .two-gates{display:grid;grid-template-columns:1fr 1fr;gap:22px;}
  @media(max-width:680px){.two-gates{grid-template-columns:1fr;}}
  .gate{
    border-radius:26px;padding:30px 26px;position:relative;overflow:hidden;
    border:2px solid transparent;background:#fff;
    box-shadow:0 8px 26px rgba(180,150,120,.1);
  }
  .gate.v{border-color:#F6C9A4;background:linear-gradient(180deg,#FFF6EE,#fff);}
  .gate.c{border-color:#BFD3EC;background:linear-gradient(180deg,#F2F7FD,#fff);}
  .gate h3{font-size:22px;font-weight:800;margin-bottom:4px;}
  .gate.v h3{color:var(--orange);}
  .gate.c h3{color:var(--blue);}
  .gate .num{font-size:44px;font-weight:900;line-height:1;margin:10px 0 4px;opacity:.85;}
  .gate.v .num{color:var(--orange);}
  .gate.c .num{color:var(--blue);}
  .gate p{color:var(--muted);font-size:14.5px;}

  /* 音标卡片 */
  .grid{display:grid;gap:14px;}
  .grid.g4{grid-template-columns:repeat(4,1fr);}
  .grid.g3{grid-template-columns:repeat(3,1fr);}
  .grid.g2{grid-template-columns:repeat(2,1fr);}
  @media(max-width:820px){
    .grid.g4{grid-template-columns:repeat(3,1fr);}
    .grid.g3{grid-template-columns:repeat(2,1fr);}
  }
  @media(max-width:560px){
    .grid.g4{grid-template-columns:repeat(2,1fr);}
    .grid.g2{grid-template-columns:1fr;}
  }

  .card{
    border:2px solid var(--line);
    background:#fff;border-radius:20px;padding:10px 8px;
    display:flex;flex-direction:column;align-items:center;gap:0;
    transition:transform .18s, box-shadow .18s, border-color .18s;
    box-shadow:0 4px 14px rgba(180,150,120,.08);
    text-align:center;
  }
  .card:hover{transform:translateY(-4px);box-shadow:0 12px 24px rgba(180,150,120,.16);}
  .card .ipa{font-size:clamp(24px,3.6vw,32px);font-weight:800;letter-spacing:1px;color:var(--blue);}
  .card .word{font-size:13px;color:var(--muted);}
  .card.warm{border-color:#F7D4B4;background:linear-gradient(180deg,#FFF8F1,#fff);}
  .card.warm .ipa{color:#D9622B;}
  .card.cool{border-color:#C6D9EF;background:linear-gradient(180deg,#F4F9FF,#fff);}
  .card.sun{border-color:#F5E1A6;background:linear-gradient(180deg,#FFFCEF,#fff);}
  .card.sun .ipa{color:#C99A18;}

  /* 可点击的音标/单词按钮 */
  .ipa-hit,.word-hit{
    width:100%;
    font-family:inherit;
    cursor:pointer;
    border:none;
    background:transparent;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:2px;
    padding:6px 4px;
    border-radius:12px;
    transition:background .16s, transform .1s;
  }
  .ipa-hit:hover,.word-hit:hover{ background:rgba(232,131,58,.10); }
  .ipa-hit:active,.word-hit:active{ transform:scale(.97); }

  /* 大卡片 */
  .big-card{
    text-align:left;
    border:2px solid var(--line);background:#fff;border-radius:22px;
    padding:22px 20px;transition:transform .18s, box-shadow .18s;
    box-shadow:0 4px 16px rgba(180,150,120,.08);
  }
  .big-card:hover{transform:translateY(-4px);box-shadow:0 14px 28px rgba(180,150,120,.16);}
  .big-card .ipa-xl{font-size:38px;font-weight:900;color:var(--orange);letter-spacing:1px;}
  .big-card .tip{
    display:inline-block;background:var(--yellow-soft);color:#A5791A;
    font-size:13px;font-weight:700;padding:3px 12px;border-radius:999px;margin:8px 0;
  }
  .big-card .desc{font-size:14.5px;color:var(--ink);}
  .big-card .desc b{color:var(--blue);}
  .big-card .prac{margin-top:10px;font-size:13px;color:var(--muted);}
  .big-card.cool .ipa-xl{color:var(--blue);}
  .big-card.sun .ipa-xl{color:#C99A18;}

  .big-card .ipa-hit{
    display:inline-flex;
    width:auto;
    align-items:flex-start;
    padding:2px 10px;
    margin-left:-10px;
    border-radius:10px;
  }
  .big-card .ipa-hit:hover{ background:rgba(232,131,58,.12); }

  /* 行内可点击单词 */
  .word-inline{
    font-family:inherit;
    font-size:inherit;
    font-weight:700;
    color:var(--blue);
    background:transparent;
    border:none;
    cursor:pointer;
    border-bottom:2px dotted rgba(74,111,165,.35);
    padding:0 2px;
    border-radius:4px;
    transition:background .15s, color .15s;
  }
  .word-inline:hover{ background:var(--blue-soft); color:#2E5688; }
  .word-inline:active{ transform:scale(.97); }

  /* 卡片中的单词行 */
  .word-line{
    font-size:13px;
    color:var(--muted);
    text-align:center;
    padding:4px 2px;
    line-height:1.6;
  }

  /* 清浊辅音行 */
  .pair{
    display:grid;grid-template-columns:1fr auto 1fr;align-items:center;
    gap:10px;margin-bottom:12px;
  }
  .ph{
    border-radius:16px;padding:8px 6px;
    display:flex;flex-direction:column;align-items:center;gap:0;
    border:2px solid;transition:transform .16s, box-shadow .16s;
    background:#fff;
  }
  .ph:hover{transform:translateY(-3px);box-shadow:0 10px 20px rgba(180,150,120,.16);}
  .ph .sym{font-size:24px;font-weight:800;}
  .ph .ex{font-size:12.5px;opacity:.8;}
  .ph.clear{border-color:#BFD3EC;background:linear-gradient(180deg,#F3F8FE,#fff);color:var(--blue);}
  .ph.voiced{border-color:#F7D4B4;background:linear-gradient(180deg,#FFF7F0,#fff);color:#D9622B;}
  .ph .ipa-hit,.ph .word-hit{ width:100%; padding:3px 2px; }
  .ph .ipa-hit:hover,.ph .word-hit:hover{ background:rgba(232,131,58,.10); }
  .arrow{color:var(--muted);font-size:16px;font-weight:700;}
  .note{font-size:13.5px;color:var(--muted);margin-top:6px;}

  /* 测验 */
  .quiz-q{
    background:#fff;border:2px solid var(--line);border-radius:20px;
    padding:20px 22px;margin-bottom:16px;
    box-shadow:0 4px 16px rgba(180,150,120,.08);
  }
  .quiz-q .q-title{font-size:16px;font-weight:800;margin-bottom:12px;}
  .quiz-q .q-title span{color:var(--orange);}
  .opts{display:flex;gap:10px;flex-wrap:wrap;}
  .opt{
    font-family:inherit;cursor:pointer;font-size:15px;font-weight:700;
    border:2px solid var(--line);background:#FFFDFA;color:var(--ink);
    padding:9px 20px;border-radius:999px;transition:.16s;
  }
  .opt:hover{border-color:var(--orange);color:var(--orange);}
  .opt.right{background:#E7F6EE;border-color:var(--green);color:#2E8B57;}
  .opt.wrong{background:#FDECEC;border-color:var(--red);color:#C94A4A;}
  .quiz-q.answered .opt{cursor:default;}
  .fb{font-size:13.5px;margin-top:10px;font-weight:700;min-height:20px;}
  .fb.ok{color:#2E8B57;}
  .fb.no{color:#C94A4A;}

  /* 口诀 */
  .rules{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
  @media(max-width:680px){.rules{grid-template-columns:1fr;}}
  .rule{
    background:#fff;border-radius:22px;padding:24px 24px;
    border-left:6px solid var(--orange);
    box-shadow:0 6px 20px rgba(180,150,120,.1);
  }
  .rule:nth-child(2){border-left-color:var(--blue);}
  .rule:nth-child(3){border-left-color:var(--yellow);}
  .rule:nth-child(4){border-left-color:var(--green);}
  .rule h4{font-size:17px;font-weight:800;margin-bottom:8px;}
  .rule p{font-size:14.5px;color:#5B5B6B;}
  .rule .sym{color:var(--blue);font-weight:700;}

  /* 结尾 */
  .final{text-align:center;padding-bottom:120px;}
  .final .medal{font-size:64px;animation:bounce 2.6s ease-in-out infinite;}
  .final h2{font-size:clamp(26px,4.4vw,40px);margin:8px 0 10px;}
  .task{
    display:inline-block;background:#fff;border:2px dashed #F0C9A8;
    border-radius:22px;padding:20px 30px;margin-top:18px;
    font-size:15px;color:#6A6A7A;text-align:left;max-width:560px;
  }

  /* 动效 */
  .reveal{opacity:0;transform:translateY(26px);transition:opacity .65s ease, transform .65s ease;}
  .reveal.show{opacity:1;transform:none;}
  .pop{animation:pop .4s ease;}
  @keyframes pop{0%{transform:scale(1)}40%{transform:scale(1.07)}100%{transform:scale(1)}}

  .hint{font-size:12.5px;color:#B0A79C;text-align:center;margin-top:18px;}

  /* 发音状态提示 */
  .toast{
    position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);
    background:rgba(58,58,74,.92);color:#fff;font-size:13.5px;font-weight:600;
    padding:10px 22px;border-radius:999px;z-index:200;
    opacity:0;transition:opacity .25s, transform .25s;pointer-events:none;
    max-width:calc(100vw - 40px);text-align:center;
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
</style>
</head>
<body>

<div id="progress"></div>
<div class="toast" id="toast"></div>

<!-- 首屏 -->
<header class="hero">
  <h1>48 个国际音标</h1>
  <div class="big">易老师英语课堂 例词跟读练习卡</div>
  <div class="tags">
    <span class="tag">元音 20 个</span>
    <span class="tag">辅音 28 个</span>
    <span class="tag">真人发音 · 跟读练习</span>
  </div>
  <button class="btn-main" onclick="document.getElementById('gates').scrollIntoView()">开始练习吧</button>
  <p class="hint">💡 点击音标听标准例词发音，点击单词直接朗读</p>
</header>

<!-- 两关总览 -->
<section id="gates">
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">今天要闯两关</span>
      <h2>48 个音标分成两大类，先认识它们的家</h2>
      <p class="sub">元音靠气流自由通过，辅音靠嘴巴和舌头制造阻碍。</p>
    </div>
    <div class="two-gates">
      <div class="gate v reveal">
        <h3>第一关 · 元音</h3>
        <div class="num">20</div>
        <p>12 个单元音 ＋ 8 个双元音</p>
      </div>
      <div class="gate c reveal">
        <h3>第二关 · 辅音</h3>
        <div class="num">28</div>
        <p>20 个成对清浊音 ＋ 8 个其他辅音</p>
      </div>
    </div>
  </div>
</section>

<!-- 元音城堡 -->
<section>
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">第一关 · 元音城堡</span>
      <h2>为什么嘴巴张得不一样，声音就不一样？</h2>
      <p class="sub">摸摸你的喉咙，发“啊——”的时候手在抖。这就是元音：气流从嘴巴里顺畅地跑出来。</p>
    </div>
  </div>
</section>

<!-- 12 个单元音 -->
<section style="padding-top:0">
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">12 个单元音</span>
      <h2>先认脸 · 每个音标读两秒</h2>
      <p class="sub">点击音标听它的标准例词，点击单词单独听。</p>
    </div>
    <div class="grid g4">
      <div class="card warm reveal">
        <button class="ipa-hit" data-ipa="/iː/"><span class="ipa">/iː/</span></button>
        <button class="word-hit" data-word="see"><span class="word">see 看见</span></button>
      </div>
      <div class="card warm reveal">
        <button class="ipa-hit" data-ipa="/ɪ/"><span class="ipa">/ɪ/</span></button>
        <button class="word-hit" data-word="sit"><span class="word">sit 坐</span></button>
      </div>
      <div class="card warm reveal">
        <button class="ipa-hit" data-ipa="/e/"><span class="ipa">/e/</span></button>
        <button class="word-hit" data-word="egg"><span class="word">egg 鸡蛋</span></button>
      </div>
      <div class="card warm reveal">
        <button class="ipa-hit" data-ipa="/æ/"><span class="ipa">/æ/</span></button>
        <button class="word-hit" data-word="cat"><span class="word">cat 猫</span></button>
      </div>

      <div class="card cool reveal">
        <button class="ipa-hit" data-ipa="/ɑː/"><span class="ipa">/ɑː/</span></button>
        <button class="word-hit" data-word="car"><span class="word">car 汽车</span></button>
      </div>
      <div class="card cool reveal">
        <button class="ipa-hit" data-ipa="/ɒ/"><span class="ipa">/ɒ/</span></button>
        <button class="word-hit" data-word="dog"><span class="word">dog 狗</span></button>
      </div>
      <div class="card cool reveal">
        <button class="ipa-hit" data-ipa="/ɔː/"><span class="ipa">/ɔː/</span></button>
        <button class="word-hit" data-word="door"><span class="word">door 门</span></button>
      </div>
      <div class="card cool reveal">
        <button class="ipa-hit" data-ipa="/uː/"><span class="ipa">/uː/</span></button>
        <button class="word-hit" data-word="food"><span class="word">food 食物</span></button>
      </div>

      <div class="card sun reveal">
        <button class="ipa-hit" data-ipa="/ʊ/"><span class="ipa">/ʊ/</span></button>
        <button class="word-hit" data-word="book"><span class="word">book 书</span></button>
      </div>
      <div class="card sun reveal">
        <button class="ipa-hit" data-ipa="/ʌ/"><span class="ipa">/ʌ/</span></button>
        <button class="word-hit" data-word="cup"><span class="word">cup 杯子</span></button>
      </div>
      <div class="card sun reveal">
        <button class="ipa-hit" data-ipa="/ɜː/"><span class="ipa">/ɜː/</span></button>
        <button class="word-hit" data-word="bird"><span class="word">bird 鸟</span></button>
      </div>
      <div class="card sun reveal">
        <button class="ipa-hit" data-ipa="/ə/"><span class="ipa">/ə/</span></button>
        <button class="word-hit" data-word="about"><span class="word">about 关于</span></button>
      </div>
    </div>
  </div>
</section>

<!-- 前元音四兄妹 -->
<section>
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">前元音</span>
      <h2>前元音四兄妹 · 嘴巴越张越大</h2>
      <p class="sub">舌尖抵住下齿，舌前部抬高，从紧到松、从小张到大张。</p>
    </div>
    <div class="grid g2">
      <div class="big-card warm reveal">
        <button class="ipa-hit" data-ipa="/iː/"><span class="ipa-xl">/iː/</span></button>
        <div class="tip">嘴角向两边咧，像微笑</div>
        <div class="desc">长长的“衣——”，舌尖抵下齿：
          <button class="word-inline" data-word="see">see</button> /
          <button class="word-inline" data-word="tree">tree</button> /
          <button class="word-inline" data-word="cheese">cheese</button>
        </div>
        <div class="prac">小练习：<button class="word-inline" data-word="sheep">sheep 绵羊</button> 🔊</div>
      </div>
      <div class="big-card warm reveal">
        <button class="ipa-hit" data-ipa="/ɪ/"><span class="ipa-xl">/ɪ/</span></button>
        <div class="tip">嘴放松，短而快</div>
        <div class="desc">短短的“衣”，比 /iː/ 更松更短：
          <button class="word-inline" data-word="sit">sit</button> /
          <button class="word-inline" data-word="big">big</button> /
          <button class="word-inline" data-word="fish">fish</button>
        </div>
        <div class="prac">小练习：<button class="word-inline" data-word="ship">ship 轮船</button> 🔊</div>
      </div>
      <div class="big-card warm reveal">
        <button class="ipa-hit" data-ipa="/e/"><span class="ipa-xl">/e/</span></button>
        <div class="tip">嘴半开，能塞一根手指</div>
        <div class="desc">像“哎”的短音：
          <button class="word-inline" data-word="egg">egg</button> /
          <button class="word-inline" data-word="pen">pen</button> /
          <button class="word-inline" data-word="red">red</button>
        </div>
        <div class="prac">小练习：<button class="word-inline" data-word="head">head 头</button> 🔊</div>
      </div>
      <div class="big-card warm reveal">
        <button class="ipa-hit" data-ipa="/æ/"><span class="ipa-xl">/æ/</span></button>
        <div class="tip">嘴张大，能塞两根手指</div>
        <div class="desc">像“安”但嘴更开、更扁：
          <button class="word-inline" data-word="cat">cat</button> /
          <button class="word-inline" data-word="bag">bag</button> /
          <button class="word-inline" data-word="apple">apple</button>
        </div>
        <div class="prac">小练习：<button class="word-inline" data-word="hand">hand 手</button> 🔊</div>
      </div>
    </div>
  </div>
</section>

<!-- 后元音五兄弟 -->
<section>
  <div class="wrap">
    <div class="reveal">
